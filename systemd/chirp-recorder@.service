[Unit]
Description=chirp-recorder chirp timing recorder for %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
User=chirprec
Group=chirprec

WatchdogSec=180
NotifyAccess=main

EnvironmentFile=-/etc/sigmond/coordination.env
EnvironmentFile=-/etc/chirp-recorder/env/%i.env

WorkingDirectory=/opt/git/sigmond/chirp-recorder

# Data lives under /var/lib/chirp-recorder/<KEY>/ (the daemon creates it as chirprec).
ExecStartPre=+/bin/mkdir -p /var/lib/chirp-recorder /var/log/chirp-recorder
ExecStartPre=+/usr/bin/chown chirprec:chirprec /var/lib/chirp-recorder
ExecStartPre=+/usr/bin/chown -R chirprec:chirprec /var/log/chirp-recorder

# %i names the instance: the reporter key (AC0G-B1A).  --instance %i reads
# /etc/chirp-recorder/AC0G-B1A.toml, whose [instance] reporter_id names every
# row and whose [[radiod]] blocks name that receiver's radiod.  The instance
# name and the radiod stay separate settings.
ExecStart=/opt/git/sigmond/chirp-recorder/venv/bin/python3 -m chirp_recorder.cli daemon --instance %i

TimeoutStartSec=60
Restart=always
RestartSec=5

StandardOutput=append:/var/log/chirp-recorder/%i.log
StandardError=inherit
SyslogIdentifier=chirp-recorder@%i

Nice=5
# 2G until Task 23 measures the real figure.
MemoryMax=2G
MemorySwapMax=0

NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/chirp-recorder /var/log/chirp-recorder
# The sink: codar.spots and the sigmondb chirp rows.  The
# "-" lets a host without sigmond or hs-uploader start anyway.
ReadWritePaths=-/var/lib/hs-uploader -/var/lib/sigmond
ReadOnlyPaths=/etc/chirp-recorder /run/hf-timestd
PrivateNetwork=false

CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
