# chirp-recorder per-instance config: /etc/chirp-recorder/<KEY>.toml
# KEY is the reporter id with '/' and '=' turned to '-' (AC0G/B1A -> AC0G-B1A).
# Coordinates below are made up.  Use your receiver's own.

[instance]
reporter_id = "CALL/ID"

[station]
callsign = "CALL"
# Timing uses the precise position.  With only grid_square, timing offsets
# are withheld until receiver_lat and receiver_lon are set.
grid_square = "EM28ab"
receiver_lat = 38.0
receiver_lon = -95.0

[paths]
output_dir = "/var/lib/chirp-recorder/CALL-ID"

[processing]
interval_s = 30

[picker]
phase = "establish"
max_channels = 2

# One block per radiod channel.  Transmitter ids come from data/chirp-seed.toml.
# sample_rate_hz is one of 64000, 96000, 128000, 192000.
[[channel]]
name = "example"
status = "<radiod-status-dns-name>"
centre_hz = 4463000
sample_rate_hz = 64000
transmitters = ["AGL1"]
# Only the physics stopgap reads this: the phase of each transmitter's sweep
# onset after the UTC second, in samples at sample_rate_hz (docs/SWEEP-TIMING.md).
# A codar-sounder value does not carry over (opposite sign, no UTC reference).
# Re-derive it from the rows: (delay_ns - path delay) * sample_rate_hz / 1e9.
# tdma_offset_samples = { AGL1 = 0 }

# The scout watches radiod's spectrum (never IQ) for chirp sweeps and sends
# sweep and scout_dwell rows.  Off by default.  Uncomment to tune; every key shown
# holds its default.  status and state_dir fall back to the first [[channel]]'s
# status and <output_dir>/scout.
# [scout]
# # false: the unit exits 0 at once.  true starts the watch.
# enabled = false
# # radiod status DNS name; "" takes the first [[channel]]'s.
# status = ""
# # top of the coarse spectrum, Hz (half the RX888 sample rate).
# nyquist_hz = 64800000.0
# # coarse spectrum bin width, Hz.
# coarse_bin_hz = 4000.0
# # seconds between coarse spectrum polls.
# coarse_poll_s = 0.4
# # seconds of coarse history the line search keeps.
# coarse_window_s = 3600.0
# # width of each fine window, Hz.
# fine_span_hz = 2000000.0
# # fine spectrum bin width, Hz.
# fine_bin_hz = 150.0
# # seconds between fine spectrum polls.
# fine_poll_s = 0.15
# # seconds the fine window stays on one target.
# dwell_s = 45.0
# # fewest frames a dwell needs before it writes a scout_dwell row.
# min_frames = 100
# # fine window centres, MHz, one per CODAR band.
# targets_mhz = [4.86, 9.33, 13.50, 16.15, 25.40]
# # hosts that publish the known chirp list.
# public_hosts = ["https://db2.wspr.live", "https://wd1.wsprdaemon.org", "https://wd2.wsprdaemon.org"]
# # seconds between refreshes of that list.
# refresh_s = 3600.0
# # cache and JSONL directory; the default is <output_dir>/scout.
# state_dir = "/var/lib/chirp-recorder/CALL-ID/scout"

# [physics] is defined with the physics stopgap.
