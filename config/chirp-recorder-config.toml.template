# chirp-recorder per-instance config: /etc/chirp-recorder/<KEY>.toml
# KEY is the reporter id with '/' and '=' turned to '-' (AC0G/B1A -> AC0G-B1A).
# Coordinates below are made up.  Use your receiver's own.

[instance]
reporter_id = "CALL/ID"

[station]
callsign = "CALL"
# Timing uses the precise position.  With only grid_square, timing offsets
# are withheld until receiver_lat and receiver_lon are set.
grid_square = "EM28ab"
receiver_lat = 38.0
receiver_lon = -95.0

[paths]
output_dir = "/var/lib/chirp-recorder/CALL-ID"

[processing]
interval_s = 30

[picker]
phase = "establish"
max_channels = 2

# One block per radiod channel.  Transmitter ids come from data/chirp-seed.toml.
# sample_rate_hz is one of 64000, 96000, 128000, 192000.
[[channel]]
name = "example"
status = "<radiod-status-dns-name>"
centre_hz = 4463000
sample_rate_hz = 64000
transmitters = ["AGL1"]
# Only the physics stopgap reads this (samples):
# tdma_offset_samples = { AGL1 = 0 }

# [physics] is defined with the physics stopgap.
